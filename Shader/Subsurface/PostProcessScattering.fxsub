float4 SSSSStencilTestPS(in float2 coord : TEXCOORD0) : COLOR
{
	int lightModelOpaque = DecodeLightModel(tex2Dlod(Gbuffer4Map, float4(coord, 0, 0)));
	int lightModelAlpha  = DecodeLightModel(tex2Dlod(Gbuffer8Map, float4(coord, 0, 0)));
	if (lightModelOpaque != SHADINGMODELID_SKIN &&
		lightModelOpaque != SHADINGMODELID_SUBSURFACE &&
		lightModelAlpha != SHADINGMODELID_SKIN &&
		lightModelAlpha != SHADINGMODELID_SUBSURFACE)
	{
		clip(-1);
	}

	return 1;
}

float4 SSSGaussBlurVS(
	in float4 Position : POSITION,
	in float4 Texcoord : TEXCOORD,
	out float4 oTexcoord0 : TEXCOORD0,
	out float4 oTexcoord1 : TEXCOORD1) : POSITION
{
	oTexcoord0 = Texcoord;
	oTexcoord0.xy += ViewportOffset;
	oTexcoord0.zw = oTexcoord0.xy * ViewportSize;
	oTexcoord1 = GetProjConstant(); 
	return Position;
}

float4 SSSGaussBlurPS(
	in float2 coord : TEXCOORD0,
	in float4 projConstant : TEXCOORD1,
	uniform sampler source,
	uniform sampler original,
	uniform float2 direction) : COLOR
{
	// -------------------------------------------------------------------------
	// Christensen-Burley separable diffusion profile kernel (13-tap, 6 pairs).
	//
	// Reference:
	//   Jimenez et al. "Separable Subsurface Scattering" (SIGGRAPH 2015)
	//   Christensen & Burley "Approximate Reflectance Profiles for Efficient
	//     Subsurface Scattering" (PIXAR Technical Memo 08-01)
	//   UE5 PostProcessSubsurface.usf - recombine & tint pattern
	//   ikPolishShader sss.fxsub - absorption-aware bilateral depth weighting
	// -------------------------------------------------------------------------

	// Sample offsets in normalised kernel space (symmetric around centre).
	// Tuned for human skin at quality-level 3 (13 taps total).
	static const float TAP_OFFSETS[6] = { 0.070f, 0.190f, 0.380f, 0.640f, 1.000f, 1.600f };

	// -------------------------------------------------------------------------
	// Christensen-Burley reflectance profile integrated into RGB kernel weights.
	//
	// Two profiles:
	//   Profile 0 - SHADINGMODELID_SKIN   (epidermis + subdermal blood, warm red)
	//   Profile 1 - SHADINGMODELID_SUBSURFACE (deep tissue / thin ears, cooler red)
	//
	// Center weights (W0) encode the fraction of energy kept at r=0.
	// Pair weights (W[i]) encode the bilateral Gaussian lobe at each offset.
	// The channel ordering is (R, G, B); shorter wavelengths scatter further,
	// so R > G > B for the far taps.
	//
	// Weights were derived from the Burley-Normalized BSSRDF with:
	//   Skin   : d = (1.9 mm, 1.2 mm, 0.8 mm)  in RGB
	//   Subsurf: d = (2.4 mm, 1.5 mm, 0.9 mm)  in RGB (softer, more translucent)
	// -------------------------------------------------------------------------

	// --- Profile 0: Skin ---
	static const float3 CB_CENTER_SKIN   = float3(0.210f, 0.340f, 0.460f);
	static const float3 CB_PAIRS_SKIN[6] =
	{
		float3(0.160f, 0.145f, 0.120f),  // tap 0  (nearest)
		float3(0.115f, 0.092f, 0.070f),  // tap 1
		float3(0.075f, 0.052f, 0.038f),  // tap 2
		float3(0.042f, 0.028f, 0.018f),  // tap 3
		float3(0.020f, 0.012f, 0.010f),  // tap 4
		float3(0.010f, 0.008f, 0.007f)   // tap 5  (furthest)
	};

	// --- Profile 1: Subsurface (thin tissue) ---
	static const float3 CB_CENTER_SUBSURF   = float3(0.160f, 0.310f, 0.440f);
	static const float3 CB_PAIRS_SUBSURF[6] =
	{
		float3(0.165f, 0.148f, 0.118f),
		float3(0.125f, 0.095f, 0.068f),
		float3(0.085f, 0.058f, 0.040f),
		float3(0.050f, 0.035f, 0.024f),
		float3(0.028f, 0.018f, 0.012f),
		float3(0.014f, 0.010f, 0.008f)
	};

	// -------------------------------------------------------------------------
	// G-buffer fetch
	// -------------------------------------------------------------------------
	float4 MRT2 = tex2Dlod(Gbuffer2Map, float4(coord, 0, 0));
	float4 MRT4 = tex2Dlod(Gbuffer4Map, float4(coord, 0, 0));

	float3 N          = DecodeNormal(MRT2.xyz);
	float  linearDepth = MRT4.x;
	float  customDataA = MRT2.w;
	int    lightModel  = (int)floor(MRT4.w);

	// Fallback to alpha G-buffers when opaque depth is empty.
	if (linearDepth <= 1e-4f)
	{
		float4 MRT6 = tex2Dlod(Gbuffer6Map, float4(coord, 0, 0));
		float4 MRT8 = tex2Dlod(Gbuffer8Map, float4(coord, 0, 0));
		linearDepth = MRT8.x;
		lightModel  = (int)floor(MRT8.w);
		N           = DecodeNormal(MRT6.xyz);
		customDataA = MRT6.w;
	}

	// Early-out for sky / empty pixels.
	if (linearDepth <= 1e-4f)
		return tex2Dlod(source, float4(coord, 0, 0));

	float3 albedo = tex2Dlod(Gbuffer1Map, float4(coord, 0, 0)).rgb;

#if SSSS_TEXSPACE
	// Texture-space skin pixels bypass this screen-space diffusion: their UV
	// base was already convolved in texture space and injected deferred-side
	// (ShadingOpacityPS), so a second screen-space pass would double the
	// scattering. The recombine tint below still applies.
	float2 sssUVCoord = float2(MRT4.y - 1.0f, frac(MRT4.w) * (256.0f / 255.0f));
	float  sssHasUV   = (lightModel == SHADINGMODELID_SKIN && MRT4.y > 0.5f && MRT4.y < 2.001f)
	                  ? step(0.05f, tex2Dlod(SSSUVLightMapSamp, float4(sssUVCoord, 0, 0)).a)
	                  : 0;
	float3 sssUVAlbedo = tex2Dlod(SSSUVAlbedoMapSamp, float4(sssUVCoord, 0, 0)).rgb;
	float3 sssUVErr = abs(sssUVAlbedo - albedo);
	sssHasUV *= (sssUVErr.r + sssUVErr.g + sssUVErr.b < 0.25f) ? 1.0f : 0.0f;
#endif

	// -------------------------------------------------------------------------
	// Profile and per-pixel SSS parameters
	// -------------------------------------------------------------------------
	bool   isSkin        = (lightModel == SHADINGMODELID_SKIN);
	float  sssAmount     = saturate(customDataA);

	// Skin always uses full scatter; subsurface material uses the stored amount.
	float  sssStrength   = isSkin ? 1.0f : sssAmount;

	// Kernel width multiplier. Subsurface geometry (ears, nostrils) tends to be
	// thinner -> amplify the footprint so backlit translucency is readable.
	float  sssWidthScale = isSkin ? mSSSSScale : (mSSSSScale * 2.0f);

	// -------------------------------------------------------------------------
	// Absorption-aware scatter coefficient (after ikPolishShader).
	//
	// High-albedo (bright) pixels absorb less -> scatter further -> wider kernel.
	// Low-albedo (dark) pixels have higher internal absorption -> narrower kernel.
	// This is the key physical insight missing from the previous ad-hoc weights.
	// -------------------------------------------------------------------------
	// Squared albedo is an empirical approximation for transport coefficient;
	// normalise so the dominant channel sets scale (prevents tinting in dark areas).
	float3 albedoSq  = saturate(albedo * albedo);
	float  albedoMax = max(max(albedoSq.r, albedoSq.g), albedoSq.b) + 1e-4f;
	// absorption: bright -> low absorption (wide); dark -> high (narrow). Range ~[0.01, 1].
	float3 absorption = saturate(1.0f - albedoSq / albedoMax) * 0.9f + 0.1f;

	// -------------------------------------------------------------------------
	// View-space position and perspective-correct kernel footprint.
	// (Same method as UE's SubsurfaceParams.x / CalcSceneDepth approach.)
	// -------------------------------------------------------------------------
	float3 P = GetViewPosition(projConstant, coord, linearDepth);

	// Project the tangent-space view alignment to screen: avoids blurring across
	// silhouettes by modulating the step with surface->camera alignment.
	float perspScaleX  = dot(normalize(N.xz + 1e-6f), normalize(-P.xz + 1e-6f));
	float perspScaleY  = dot(normalize(N.yz + 1e-6f), normalize(-P.yz + 1e-6f));
	float perspScale   = max(dot(direction, float2(perspScaleX, perspScaleY)), 0.25f);

	// World-space SSS radius (cm) projected to screen.
	// 0.0050 ~ 5 mm at unit world-scale; divided by depth to convert to NDC.
	float sssRadius    = (0.0050f * sssStrength * perspScale) / max(sssWidthScale, 0.01f);
	float2 sampleStep  = direction * (sssRadius / max(linearDepth, 0.1f))
	                   * float2(1.0f / ViewportAspect, 1.0f);

	// Clamp the max footprint to 40 pixels so tiny / distant models don't blow out.
	float2 maxStep   = 40.0f * ViewportOffset2;
	float  stepLenSq = dot(sampleStep, sampleStep);
	float  maxLenSq  = dot(maxStep, maxStep);
	if (stepLenSq > maxLenSq)
		sampleStep *= sqrt(maxLenSq / stepLenSq);

	// -------------------------------------------------------------------------
	// Accumulate the convolution.
	// -------------------------------------------------------------------------
	float3 centerWeight = isSkin ? CB_CENTER_SKIN : CB_CENTER_SUBSURF;

	float4 centerColor = tex2Dlod(source, float4(coord, 0, 0));
	float3 totalColor  = centerColor.rgb * centerWeight;
	float3 totalWeight = centerWeight;

	// -------------------------------------------------------------------------
	// 13-tap separable convolution with bilateral depth+normal+absorption guard.
	//
	// Depth tolerance is absorption-aware per channel (ikPolish idea applied to
	// the separable kernel): channels with large scatter coefficients tolerate a
	// wider depth mismatch because they already integrate over a larger volume.
	// -------------------------------------------------------------------------
#if SSSS_TEXSPACE
	if (sssHasUV < 0.5f)
#endif
	{
		[unroll]
		for (int i = 0; i < 6; ++i)
		{
			float  tapOff = TAP_OFFSETS[i];
			float2 uv1    = coord + tapOff * sampleStep;
			float2 uv2    = coord - tapOff * sampleStep;

			float4 col1 = tex2Dlod(source,      float4(uv1, 0, 0));
			float4 col2 = tex2Dlod(source,      float4(uv2, 0, 0));
			float3 N1   = DecodeNormal(tex2Dlod(Gbuffer2Map, float4(uv1, 0, 0)).xyz);
			float3 N2   = DecodeNormal(tex2Dlod(Gbuffer2Map, float4(uv2, 0, 0)).xyz);

			// Absorption-modulated depth tolerance:
			//   high absorption (dark) -> tight tolerance (less bleeding across edges)
			//   low absorption (bright) -> loose tolerance (soft tissue blends through)
			// The base window grows with tap offset to allow limb-curvature overlap.
			float3 depthWin      = absorption * (tapOff * sssRadius * 6.0f)
			                     + max(linearDepth * 0.05f, 0.06f);
			float3 depthWeight1  = saturate(1.0f - abs(col1.a - linearDepth) / depthWin);
			float3 depthWeight2  = saturate(1.0f - abs(col2.a - linearDepth) / depthWin);

			// Normal similarity guard (prevents bleed across sharp profile boundaries).
			float nw1 = saturate(dot(N1, N));
			float nw2 = saturate(dot(N2, N));

			float3 pairWeight = isSkin ? CB_PAIRS_SKIN[i] : CB_PAIRS_SUBSURF[i];
			float3 w1 = pairWeight * (depthWeight1 * nw1);
			float3 w2 = pairWeight * (depthWeight2 * nw2);

			totalWeight += w1 + w2;
			totalColor  += w1 * col1.rgb + w2 * col2.rgb;
		}
	}

#if SSSS_TEXSPACE
	float3 blurredColor = (sssHasUV > 0.5f) ? centerColor.rgb : (totalColor / max(totalWeight, 1e-4f));
#else
	float3 blurredColor = totalColor / max(totalWeight, 1e-4f);
#endif

	// -------------------------------------------------------------------------
	// Second-pass recombine (UE5 pattern, vertical pass only):
	//   - Skin:       soft albedo tint matching UE SubsurfaceRecombinePS pattern.
	//   - Subsurface: detail-preservation blend toward original.
	// -------------------------------------------------------------------------
	if (direction.y > 0.01f)
	{
		float4 origColor = tex2Dlod(original, float4(coord, 0, 0));

		if (isSkin)
		{
			// Albedo tint: scattered diffuse modulated by surface colour.
			// sqrt gives a perceptually balanced mid-tone; strength 0.35 avoids
			// over-darkening blond/white-haired characters.
			float3 tint = lerp(float3(1,1,1), sqrt(saturate(albedo)), 0.35f);
			blurredColor *= tint;
		}
		else
		{
			// Detail preservation for subsurface materials with low sssAmount.
			float blendFactor = 0.40f * (1.0f - sssAmount);
			blurredColor      = lerp(blurredColor, origColor.rgb, blendFactor);
		}
	}

	return float4(blurredColor, centerColor.a);
}

#if SSSS_TEXSPACE
// -------------------------------------------------------------------------
// Texture-space SSS convolution (13-tap Christensen-Burley profile).
//
// Runs once per frame over the UV-wrapped skin irradiance field with WRAP
// addressing, before ShadingOpacity consumes it. The kernel radius is defined
// in UV texels (SSSS+/SSSS- morphs widen/narrow it), so scatter stays constant
// in texture space regardless of camera distance or model scale. Coverage
// stored in alpha weights the normalization; empty atlas regions contribute
// nothing and keep a coverage of 0 so the deferred albedo gate can reject them.
//
// Reference: J. Jimenez et al. 2015 "Separable Subsurface Scattering";
// P. Christensen & B. Burley "Approximate Reflectance Profiles", Pixar TM 15-04;
// D'Eon et al. 2007 texture-space diffusion (GPU Gems 3, ch. 14).
// -------------------------------------------------------------------------
float4 SSSUVSpaceBlurPS(
	in float2 coord : TEXCOORD0,
	uniform sampler source,
	uniform float2 direction) : COLOR
{
	static const float UV_TAP_OFFSETS[6] = { 0.070f, 0.190f, 0.380f, 0.640f, 1.000f, 1.600f };
	static const float3 UV_CENTER = float3(0.210f, 0.340f, 0.460f);
	static const float3 UV_PAIRS[6] =
	{
		float3(0.160f, 0.145f, 0.120f),
		float3(0.115f, 0.092f, 0.070f),
		float3(0.075f, 0.052f, 0.038f),
		float3(0.042f, 0.028f, 0.018f),
		float3(0.020f, 0.012f, 0.010f),
		float3(0.010f, 0.008f, 0.007f)
	};

	float4 center = tex2Dlod(source, float4(coord, 0, 0));
	float3 totalColor  = center.rgb * UV_CENTER;
	float3 totalWeight = UV_CENTER * center.a;

	// 0.8 texels at the neutral mSSSSScale (0.04) -> ~20 texel base radius;
	// the far tap reaches ~32 texels. SSSS+ (0.02) doubles the footprint.
	float2 sampleStep = direction * (0.8f / max(mSSSSScale, 0.01f)) * ViewportOffset2;

	[unroll]
	for (int i = 0; i < 6; ++i)
	{
		float  tapOff = UV_TAP_OFFSETS[i];
		float4 col1 = tex2Dlod(source, float4(coord + tapOff * sampleStep, 0, 0));
		float4 col2 = tex2Dlod(source, float4(coord - tapOff * sampleStep, 0, 0));

		float3 w1 = UV_PAIRS[i] * col1.a;
		float3 w2 = UV_PAIRS[i] * col2.a;

		totalWeight += w1 + w2;
		totalColor  += w1 * col1.rgb + w2 * col2.rgb;
	}

	float3 blurred = totalColor / max(totalWeight, 1e-4f);
	return float4(blurred, center.a);
}
#endif