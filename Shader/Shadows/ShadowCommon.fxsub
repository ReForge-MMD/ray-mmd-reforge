#ifndef _SHADOWS_SHADOW_COMMON_FXSUB_
#define _SHADOWS_SHADOW_COMMON_FXSUB_

// -----------------------------------------------------------------------------
// Directional / Cascaded Light View & Projection Matrices
// -----------------------------------------------------------------------------

float4x4 CreateLightViewMatrix(float3 forward, float3 lightPosition)
{
	float3 right = cross(float3(0.0f, 1.0f, 0.0f), forward);
	float3 up;

	if (any(right))
	{
		right = normalize(right);
		up = cross(forward, right);
	}
	else
	{
		right = float3(1.0f, 0.0f, 0.0f);
		up = float3(0.0f, 0.0f, -sign(forward.y));
	}

	float3x3 rotation = {
		right.x, up.x, forward.x,
		right.y, up.y, forward.y,
		right.z, up.z, forward.z
	};

	return float4x4(
		rotation[0], 0.0f,
		rotation[1], 0.0f,
		rotation[2], 0.0f,
		mul(-lightPosition, rotation), 1.0f
	);
}

float4x4 CreateLightViewMatrix(float3 forward, float3 lightDirection, float lightDistance)
{
	return CreateLightViewMatrix(forward, lightDirection * lightDistance);
}

float4 CreateFrustumSplitPoint(float n, float f, float lambda = 0.75f)
{
	float4 p = float4(1.0f, 2.0f, 3.0f, 4.0f) * 0.25f;
	float4 p0 = n + (f - n) * p;
	float4 p1 = n * pow(max(f / max(n, 1e-4f), 1e-4f), p);
	return lerp(p0, p1, lambda);
}

float4 CreateFrustumFromProjInverse()
{
	float r = dot(float4( 1.0f,  0.0f, 0.0f, 1.0f), matProjectInverse._11_21_31_41);
	float l = dot(float4(-1.0f,  0.0f, 0.0f, 1.0f), matProjectInverse._11_21_31_41);
	float t = dot(float4( 0.0f,  1.0f, 0.0f, 1.0f), matProjectInverse._12_22_32_42);
	float b = dot(float4( 0.0f, -1.0f, 0.0f, 1.0f), matProjectInverse._12_22_32_42);
	return float4(r, l, t, b);
}

float4 CreateLightCropParam(float4x4 matLightViewFromCameraView, float4 frustumInfo, int shadowMapSize, float nearZ, float farZ)
{
	float4 zfar = float4(farZ.xxx, 1.0f);
	float4 znear = float4(nearZ.xxx, 1.0f);

	float4 rtn = float4(frustumInfo.xz, 1.0f, 1.0f) * znear;
	float4 rtf = float4(frustumInfo.xz, 1.0f, 1.0f) * zfar;
	float4 lbn = float4(frustumInfo.yw, 1.0f, 1.0f) * znear;
	float4 lbf = float4(frustumInfo.yw, 1.0f, 1.0f) * zfar;

	float4 rbn = float4(rtn.x, lbn.yzw);
	float4 rbf = float4(rtf.x, lbf.yzw);
	float4 ltn = float4(lbn.x, rtn.yzw);
	float4 ltf = float4(lbf.x, rtf.yzw);

	float2 vrtn = mul(rtn, matLightViewFromCameraView).xy;
	float2 vrtf = mul(rtf, matLightViewFromCameraView).xy;
	float2 vlbn = mul(lbn, matLightViewFromCameraView).xy;
	float2 vlbf = mul(lbf, matLightViewFromCameraView).xy;
	float2 vrbn = mul(rbn, matLightViewFromCameraView).xy;
	float2 vrbf = mul(rbf, matLightViewFromCameraView).xy;
	float2 vltn = mul(ltn, matLightViewFromCameraView).xy;
	float2 vltf = mul(ltf, matLightViewFromCameraView).xy;

	float4 minBB = float4(vrtn, vrtf);
	float4 maxBB = minBB;
	minBB = min(float4(vlbn, vlbf), minBB);
	maxBB = max(float4(vlbn, vlbf), maxBB);
	minBB = min(float4(vrbn, vrbf), minBB);
	maxBB = max(float4(vrbn, vrbf), maxBB);
	minBB = min(float4(vltn, vltf), minBB);
	maxBB = max(float4(vltn, vltf), maxBB);

	float4 cropBB = float4(min(minBB.xy, minBB.zw), max(maxBB.xy, maxBB.zw));

	float quantizer = 64.0f;
	float2 scale = 2.0f / max(cropBB.zw - cropBB.xy, 1e-5f);
	scale = quantizer / ceil(quantizer / scale);

	float2 offset = -0.5f * (cropBB.xy + cropBB.zw) * scale;
	offset = ceil(offset * shadowMapSize * 0.5f) / (shadowMapSize * 0.5f);

	return float4(scale, offset);
}

float4x4 CreateLightCropParams(float4x4 matLightViewFromCameraView, float shadowMapSize)
{
	const float4 frustumInfo = CreateFrustumFromProjInverse();
	const float4 frustumSplit = CreateFrustumSplitPoint(mPSSMCascadeZMin, mPSSMCascadeZMax, mPSSMCascadeLambda);

	return float4x4(
		CreateLightCropParam(matLightViewFromCameraView, frustumInfo, shadowMapSize, mPSSMCascadeZMin, frustumSplit.x),
		CreateLightCropParam(matLightViewFromCameraView, frustumInfo, shadowMapSize, frustumSplit.x, frustumSplit.y),
		CreateLightCropParam(matLightViewFromCameraView, frustumInfo, shadowMapSize, frustumSplit.y, frustumSplit.z),
		CreateLightCropParam(matLightViewFromCameraView, frustumInfo, shadowMapSize, frustumSplit.z, frustumSplit.w)
	);
}

float4x4 CreateOrthoProject(float width, float height, float nearZ, float farZ)
{
	float cx = 2.0f / width;
	float cy = 2.0f / height;

	float4x4 m;
	m[0] = float4(cx,   0,  0, 0);
	m[1] = float4( 0,  cy,  0, 0);
	m[2] = float4( 0,   0,  1, 0);
	m[3] = float4( 0,   0,  0, 1);

	return m;
}

float4x4 CreatePerspectiveProject(float fov, float aspect, float nearZ, float farZ)
{
	float h = 1.0f / tan(fov);
	float w = h / aspect;
	float q = farZ / (farZ - nearZ);

	float4x4 m;
	m[0] = float4(w, 0, 0, 0);
	m[1] = float4(0, h, 0, 0);
	m[2] = float4(0, 0, q, 1);
	m[3] = float4(0, 0, -nearZ * q, 0);

	return m;
}

// -----------------------------------------------------------------------------
// Bias & Slope Utilities
// -----------------------------------------------------------------------------

float ShadowSlopeScaledBias(float depth)
{
	float dx = abs(ddx(depth));
	float dy = abs(ddy(depth));
	return min(dx, dy);
}

float2 GetReceiverPlaneDepthBias(float3 shadowCoord)
{
	float3 dx = ddx(shadowCoord);
	float3 dy = ddy(shadowCoord);

	float2 biasUV;
	biasUV.x = dy.y * dx.z - dx.y * dy.z;
	biasUV.y = dx.x * dy.z - dy.x * dx.z;
	float det = (dx.x * dy.y) - (dx.y * dy.x);

	return (abs(det) > 1e-7f) ? (biasUV * (1.0f / det)) : float2(0.0f, 0.0f);
}

// -----------------------------------------------------------------------------
// Sampling Distributions (Vogel Disc & Poisson)
// -----------------------------------------------------------------------------

#define GOLDEN_ANGLE 2.39996323f

float2 RotateSample(float2 samplePoint, float2 rotation)
{
	return float2(
		samplePoint.x * rotation.x - samplePoint.y * rotation.y,
		samplePoint.y * rotation.x + samplePoint.x * rotation.y
	);
}

float2 VogelDiscSample(int sampleIndex, int sampleCount, float phi)
{
	float r = sqrt((float(sampleIndex) + 0.5f) / float(sampleCount));
	float theta = float(sampleIndex) * GOLDEN_ANGLE + phi;
	float s, c;
	sincos(theta, s, c);
	return float2(c, s) * r;
}

