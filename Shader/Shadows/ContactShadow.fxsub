#ifndef RAY_MMD_SHADOWS_CONTACT_SHADOW_FXSUB
#define RAY_MMD_SHADOWS_CONTACT_SHADOW_FXSUB

#ifndef CONTACT_QUALITY
#	ifdef CONTACT_SHADOW_QUALITY
#		define CONTACT_QUALITY CONTACT_SHADOW_QUALITY
#	else
#		define CONTACT_QUALITY 2
#	endif
#endif

// Contact shadows are short view-space rays (<= ~0.6 units).
// Flat linear march keeps the temp register footprint within ps_3_0 budget (X4505).
#if CONTACT_QUALITY <= 1
#	define CONTACT_SHADOW_STEP_COUNT 8
#elif CONTACT_QUALITY == 2
#	define CONTACT_SHADOW_STEP_COUNT 12
#else
#	define CONTACT_SHADOW_STEP_COUNT 16
#endif

float ContactShadowSampleDepth(float2 screenUV)
{
	// Gbuffer8.x is the positive linear view-space depth.
	return abs(tex2Dlod(Gbuffer8Map, float4(screenUV, 0.0f, 0.0f)).x);
}

/**
 * Reconstructs geometric normal vector from screen-space view position partial derivatives.
 */
float3 ContactShadowGeometricNormal(float3 tangentX, float3 tangentY, float3 shadingNormal)
{
	float3 geometricNormal = cross(tangentY, tangentX);
	float normalLengthSquared = dot(geometricNormal, geometricNormal);

	if (normalLengthSquared > 1e-10f)
		geometricNormal *= rsqrt(normalLengthSquared);
	else
		geometricNormal = shadingNormal;

	return geometricNormal * (dot(geometricNormal, shadingNormal) < 0.0f ? -1.0f : 1.0f);
}

/**
 * Traces a directional screen-space ray towards the light source to compute micro-occlusion.
 */
float TraceScreenSpaceShadow(
	float3 viewPosition,
	float3 shadingNormal,
	float3 lightDirectionVS,
	float maxDistance,
	float jitter)
{
	float3 viewPositionDx = ddx(viewPosition);
	float3 viewPositionDy = ddy(viewPosition);
	float3 geometricNormal = ContactShadowGeometricNormal(viewPositionDx, viewPositionDy, shadingNormal);

	float3 lightDirection = normalize(lightDirectionVS);
	float nDotL = dot(shadingNormal, lightDirection);
	if (nDotL <= 0.0f || maxDistance <= 0.0f)
		return 1.0f;

	float terminatorFade = smoothstep(0.0f, 0.15f, nDotL);

	float pixelFootprint = max(length(viewPositionDx), length(viewPositionDy));
	pixelFootprint = min(pixelFootprint, max(0.01f, viewPosition.z * 0.01f));
	float slopeScale = 1.0f - saturate(nDotL);
	float normalBias = max(0.0025f, pixelFootprint * 0.5f) * (1.0f + 2.0f * slopeScale);
	float3 rayOrigin = viewPosition + geometricNormal * normalBias;

	float stepLength = maxDistance / (float)CONTACT_SHADOW_STEP_COUNT;
	float thickness = max(stepLength * 2.0f, normalBias * 2.5f);
	float occlusion = 0.0f;
	float hitT = 1.0f;

	float3 rayEnd = rayOrigin + lightDirection * maxDistance;
	float4 clipStart = mul(float4(rayOrigin, 1.0f), matProject);
	float4 clipEnd = mul(float4(rayEnd, 1.0f), matProject);

	[loop]
	for (int stepIndex = 0; stepIndex < CONTACT_SHADOW_STEP_COUNT; ++stepIndex)
	{
		float rayT = ((float)stepIndex + 0.5f + 0.5f * frac(jitter)) / (float)CONTACT_SHADOW_STEP_COUNT;
		float rayZ = rayOrigin.z + lightDirection.z * (rayT * maxDistance);
		float4 clipPos = lerp(clipStart, clipEnd, rayT);

		if (clipPos.w <= 0.0f)
			break;

		float2 sampleUV = clipPos.xy / clipPos.w * float2(0.5f, -0.5f) + 0.5f;

		if (any(sampleUV < 0.0f) || any(sampleUV > 1.0f))
			break;

		float sceneDepth = ContactShadowSampleDepth(sampleUV);
		float penetration = rayZ - sceneDepth;

		if (penetration > 0.0f && penetration <= thickness)
		{
			occlusion = max(occlusion, saturate(penetration / (thickness * 0.5f)));
			hitT = rayT;
			if (occlusion >= 1.0f)
				break;
		}
	}

	float distanceFade = 1.0f - smoothstep(0.65f, 1.0f, hitT);
	return 1.0f - occlusion * terminatorFade * distanceFade;
}

/**
 * Public interface for evaluating contact shadows in lighting passes.
 */
float GetContactShadow(
	float3 viewPosition,
	float3 shadingNormal,
	float3 L,
	float2 screenCoord,
	float linearDepth)
{
	float maxDistance = min(1.5f, max(0.05f, linearDepth * 0.06f));
#if AA_QUALITY == 6
	int frameCounter = (int)fmod(time * 60.0f, 16.0f);
#else
	int frameCounter = 0;
#endif
	float jitter = InterleavedGradientNoise(screenCoord * ViewportSize, frameCounter);
	float shadow = TraceScreenSpaceShadow(viewPosition, shadingNormal, L, maxDistance, jitter);
	return shadow * shadow;
}

// -----------------------------------------------------------------------
// Screen-Space Global Shadows (SSGS)
// -----------------------------------------------------------------------
#if SSGS_QUALITY >= 1

#if SSGS_QUALITY == 1
#	define SSGS_STEP_COUNT    16
#	define SSGS_MAX_DISTANCE  3.0f
#elif SSGS_QUALITY == 2
#	define SSGS_STEP_COUNT    24
#	define SSGS_MAX_DISTANCE  8.0f
#else
#	define SSGS_STEP_COUNT    32
#	define SSGS_MAX_DISTANCE  15.0f
#endif

float TraceScreenSpaceGlobalShadow(
	float3 viewPosition,
	float3 shadingNormal,
	float3 lightDirVS,
	float jitter)
{
	float3 viewPositionDx = ddx(viewPosition);
	float3 viewPositionDy = ddy(viewPosition);
	float3 geometricNormal = ContactShadowGeometricNormal(viewPositionDx, viewPositionDy, shadingNormal);

	float3 lightDirection = normalize(lightDirVS);
	float nDotL = dot(shadingNormal, lightDirection);
	if (nDotL <= 0.0f)
		return 1.0f;

	float terminatorFade = smoothstep(0.0f, 0.2f, nDotL);

	float pixelFootprint = max(length(viewPositionDx), length(viewPositionDy));
	pixelFootprint = min(pixelFootprint, max(0.01f, viewPosition.z * 0.01f));
	float slopeScale = 1.0f - saturate(nDotL);
	float normalBias = max(0.05f, pixelFootprint * 1.5f) * (1.0f + 2.0f * slopeScale);
	float3 rayOrigin = viewPosition + geometricNormal * normalBias;

	float stepLength = SSGS_MAX_DISTANCE / (float)SSGS_STEP_COUNT;
	float occlusion = 0.0f;
	float hitT = 1.0f;

	float3 rayEnd = rayOrigin + lightDirection * SSGS_MAX_DISTANCE;
	float4 clipStart = mul(float4(rayOrigin, 1.0f), matProject);
	float4 clipEnd = mul(float4(rayEnd, 1.0f), matProject);

	[loop]
	for (int stepIndex = 0; stepIndex < SSGS_STEP_COUNT; ++stepIndex)
	{
		float rayT = ((float)stepIndex + 0.5f + 0.5f * frac(jitter)) / (float)SSGS_STEP_COUNT;
		float rayZ = rayOrigin.z + lightDirection.z * (rayT * SSGS_MAX_DISTANCE);
		float4 clipPos = lerp(clipStart, clipEnd, rayT);

		if (clipPos.w <= 0.0f)
			break;

		float2 sampleUV = clipPos.xy / clipPos.w * float2(0.5f, -0.5f) + 0.5f;

		if (any(sampleUV < 0.0f) || any(sampleUV > 1.0f))
			break;

		float travelDist = rayT * SSGS_MAX_DISTANCE;
		float thickness = max(stepLength * 2.0f, travelDist * 0.08f + normalBias);

		float sceneDepth = ContactShadowSampleDepth(sampleUV);
		float penetration = rayZ - sceneDepth;

		if (penetration > 0.0f && penetration <= thickness)
		{
			float softOcclusion = saturate(penetration / (thickness * 0.5f)) * terminatorFade;
			if (softOcclusion > occlusion)
			{
				occlusion = softOcclusion;
				hitT = rayT;
			}
			if (occlusion >= 1.0f)
				break;
		}
	}

	float distanceFade = 1.0f - smoothstep(0.7f, 1.0f, hitT);
	return 1.0f - occlusion * distanceFade;
}

float GetGlobalShadow(
	float3 viewPosition,
	float3 shadingNormal,
	float3 L,
	float2 screenCoord)
{
#if AA_QUALITY == 6
	int frameCounter = (int)fmod(time * 60.0f, 16.0f);
#else
	int frameCounter = 0;
#endif
	float jitter = InterleavedGradientNoise(screenCoord * ViewportSize + float2(7.3f, 5.1f), frameCounter);
	float shadow = TraceScreenSpaceGlobalShadow(viewPosition, shadingNormal, L, jitter);
	return sqrt(shadow);
}

#endif // SSGS_QUALITY >= 1

#endif // RAY_MMD_SHADOWS_CONTACT_SHADOW_FXSUB
