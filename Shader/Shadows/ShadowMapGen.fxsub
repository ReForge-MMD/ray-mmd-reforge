#ifndef _SHADOWS_SHADOW_MAP_GEN_FXSUB_
#define _SHADOWS_SHADOW_MAP_GEN_FXSUB_

#include "shader/Shadows/CascadedShadowMap.fxsub"
#include "shader/Shadows/ContactShadow.fxsub"

float4 ShadowMapGenPS(
	in float2 coord : TEXCOORD0,
	in float3 viewdir : TEXCOORD1) : COLOR
{
	// Read opaque G-buffer layer (Gbuffer4.x = linearDepth, Gbuffer4.z = visibility).
	// Gbuffer8 is the alpha-layer; opaque geometry has Gbuffer8.x=0 and would clip.
	float4 MRT4 = tex2Dlod(Gbuffer4Map, float4(coord, 0.0f, 0.0f));
	clip(MRT4.x - 1e-5f);

	MaterialParam material;
	material.linearDepth = MRT4.x;
	material.visibility  = MRT4.z;

	clip(any(material.visibility) - 1e-5f);

	// Opaque normals are in Gbuffer2 (same layout as Gbuffer6 for alpha layer)
	float4 MRT2 = tex2Dlod(Gbuffer2Map, float4(coord, 0.0f, 0.0f));
	material.normal = DecodeNormal(MRT2.xyz);

	float4 projConstant = GetProjConstant();
	float3 viewPosition = GetViewPosition(projConstant, coord, material.linearDepth);

	// 1. Cascaded PCSS Shadow
	float shadow = EvaluateCascadedShadow(material, viewPosition, coord);

	float3 L = mul(-SunDirection, (float3x3)matView);

	// 2. Micro Contact Shadows (SSCS)
#if CONTACT_SHADOW_QUALITY >= 1
	float contactShadow = GetContactShadow(viewPosition, material.normal, L, coord, material.linearDepth);
	shadow *= contactShadow;
#endif

	// 3. Screen-Space Global Shadows (SSGS)
#if SSGS_QUALITY >= 1
	shadow *= GetGlobalShadow(viewPosition, material.normal, L, coord);
#endif

	return shadow;
}

#endif // _SHADOWS_SHADOW_MAP_GEN_FXSUB_
