// ponytail: Isotropic sine-free hash eliminates diagonal moire in screen dithering
float3 DitherHash3(float2 p)
{
	float3 p3 = frac(float3(p.xyx) * float3(0.1031f, 0.1030f, 0.0973f));
	p3 += dot(p3, p3.yzx + 33.33f);
	return frac((p3.xxy + p3.yzz) * p3.zyx);
}

float3 ColorBanding(float2 uv)
{
	float2 pixelCoord = uv * ViewportSize;
	float3 n1 = DitherHash3(pixelCoord);
	float3 n2 = DitherHash3(pixelCoord + 0.5789f);
	float3 triangularNoise = (n1 - 0.5f) + (n2 - 0.5f);
	return triangularNoise / 255.0f;
}

float3 ColorDithering(float3 color, float2 uv)
{
	return color + ColorBanding(uv);
}

float3 ColorVignette(float3 color, float2 coord)		
{		
	float2 ndc = coord * 2.0f - 1.0f;
	float L = length(ndc);
	float falloff = smoothstep(mVignetteOuter - mVignette * 2.0f, mVignetteInner - mVignette, L);
	float cosFalloff = saturate(1.0f - L * L * 0.15f * saturate(mVignette + 0.5f));
	return color * (falloff * cosFalloff);		
}

float3 ColorTemperature(float3 color, float kelvin)
{
	float temp = kelvin / 100;
	float temp60 = max(0, temp - 60);
	float red = temp <= 66 ? 255 : 329.698727446 * pow(temp60, -0.1332047592);
	float green = temp <= 66 ? 99.4708025861 * log(temp) - 161.1195681661 : 288.1221695283 * pow(temp60, -0.0755148492);
	float blue = temp >= 66 ? 255 : (temp <= 19 ? 0 : 138.5177312231 * log(temp - 10) - 305.0447927307);
	float3 balance = saturate(float3(red, green, blue) / 255);
	return color * balance;
}

float3 ColorTint(float3 color, float tint)
{
	float3 tintVec = float3(1.0f + tint * 0.5f, 1.0f - tint * 0.5f, 1.0f + tint * 0.5f);
	float lumFactor = dot(tintVec, float3(0.299f, 0.587f, 0.114f));
	tintVec /= max(1e-4f, lumFactor);
	return max(0.0f, color * tintVec);
}

float3 ColorVibrance(float3 color, float vibrance)
{
	float lum = luminance(color);
	float maxC = max(color.r, max(color.g, color.b));
	float minC = min(color.r, min(color.g, color.b));
	float sat = (maxC - minC) / max(maxC, 1e-4f);
	float satFactor = 1.0f + vibrance * (1.0f - sat);
	return max(0.0f, lerp(lum.xxx, color, satFactor));
}

float3 ColorHueShift(float3 color, float angle)
{
	const float3 k = float3(0.577350269f, 0.577350269f, 0.577350269f);
	float sinA, cosA;
	sincos(angle, sinA, cosA);
	return max(0.0f, color * cosA + cross(k, color) * sinA + k * dot(k, color) * (1.0f - cosA));
}

float3 ColorGradeTonalZone(float3 color, float saturation, float contrast, float3 gain, float lift)
{
	float lum = luminance(color);
	color = max(0.0f, lerp(lum.xxx, color, saturation));
	color = pow(max(1e-4f, color * (1.0f / 0.18f)), contrast) * 0.18f;
	color = color * gain + lift;
	return max(0.0f, color);
}

float3 ColorGrade3Way(
	float3 color,
	float shadowSat, float shadowCont, float3 shadowGain, float shadowLift,
	float midtoneSat, float midtoneCont, float3 midtoneGain,
	float highlightSat, float highlightCont, float3 highlightGain,
	float shadowMax, float highlightMin)
{
	float luma = luminance(color);
	// Perceptual luma compression (Naka-Rushton curve: maps middle gray 0.18 to 0.50)
	float pLuma = luma / (luma + 0.18f);

	float weightShadows = 1.0f - smoothstep(0.0f, shadowMax, pLuma);
	float weightHighlights = smoothstep(highlightMin, 0.80f, pLuma);
	float weightMidtones = saturate(1.0f - weightShadows - weightHighlights);

	float3 colorShadows = ColorGradeTonalZone(color, shadowSat, shadowCont, shadowGain, shadowLift);
	float3 colorMidtones = ColorGradeTonalZone(color, midtoneSat, midtoneCont, midtoneGain, 0.0f);
	float3 colorHighlights = ColorGradeTonalZone(color, highlightSat, highlightCont, highlightGain, 0.0f);

	return colorShadows * weightShadows + colorMidtones * weightMidtones + colorHighlights * weightHighlights;
}

float3 ApplyTealOrange(float3 color, float amount)
{
	float lum = luminance(color);
	float3 teal = float3(0.12f, 0.55f, 0.70f);
	float3 orange = float3(1.10f, 0.65f, 0.18f);
	float3 targetColor = lerp(teal * (lum * 2.0f), orange * (lum * 1.5f), smoothstep(0.05f, 0.65f, lum));
	return max(0.0f, lerp(color, targetColor, amount * 0.75f));
}

float3 ApplyBleachBypass(float3 color, float amount)
{
	float lum = luminance(color);
	float3 blend = (lum < 0.5f) ? (2.0f * color * lum) : (1.0f - 2.0f * (1.0f - color) * (1.0f - lum));
	float3 bleach = lerp(blend, lum.xxx, 0.30f);
	return max(0.0f, lerp(color, bleach, amount));
}

float3 ApplyCrossProcess(float3 color, float amount)
{
	float3 cp;
	cp.r = color.r < 0.5f ? 2.0f * color.r * color.r : 1.0f - 2.0f * (1.0f - color.r) * (1.0f - color.r);
	cp.g = color.g * 1.15f;
	cp.b = color.b < 0.5f ? color.b * 1.35f : 1.0f - (1.0f - color.b) * 0.75f;
	return max(0.0f, lerp(color, cp, amount * 0.70f));
}

float3 ApplyMonochrome(float3 color, float amount)
{
	float lum = dot(color, float3(0.299f, 0.587f, 0.114f));
	return lerp(color, lum.xxx, amount);
}

float3 ColorCorrect(
	float3 color,
	float colorSaturation,
	float colorContrast,
	float colorGamma,
	float3 colorGainP,
	float3 colorGainM)
{
	float3 lum = luminance(color);
	color = max(0, lerp(lum, color, colorSaturation));
	float combinedExponent = colorContrast * colorGamma;
	float scale = pow(0.18f, colorGamma);
	color = pow(color * (1.0f / 0.18f), combinedExponent) * (scale * (colorGainP + 1.0f - colorGainM));
	return color;
}

float3 ColorCorrect(
	float3 color,
	float3 colorSaturation,
	float3 colorContrast,
	float3 colorGamma,
	float3 colorGain,
	float3 colorOffset)
{
	float3 lum = luminance(color);
	color = max(0, lerp(lum, color, colorSaturation.rgb));
	color = pow(color * (1.0 / 0.18), colorContrast.rgb) * 0.18;
	color = pow(color, 1.0 / colorGamma.rgb);
	color = color * colorGain.rgb + colorOffset.rgb;
	return max(0, color);
}

float3 ColorCorrectAll(
	float3 color,
	float3 colorSaturation,
	float3 colorContrast,
	float3 colorGamma,
	float3 colorGain,
	float3 colorOffset,

	float3 colorSaturationShadows,
	float3 colorContrastShadows,
	float3 colorGammaShadows,
	float3 colorGainShadows,
	float3 colorOffsetShadows,

	float3 colorSaturationMidtones,
	float3 colorContrastMidtones,
	float3 colorGammaMidtones,
	float3 colorGainMidtones,
	float3 colorOffsetMidtones,

	float3 colorSaturationHighlights,
	float3 colorContrastHighlights,
	float3 colorGammaHighlights,
	float3 colorGainHighlights,
	float3 colorOffsetHighlights,

	float colorCorrectionShadowsMax,
	float colorCorrectionHighlightsMin)
{
	float3 colorShadows = ColorCorrect(color, 
		colorContrastShadows*colorContrast, 
		colorSaturationShadows*colorSaturation, 
		colorGammaShadows*colorGamma, 
		colorGainShadows*colorGain, 
		colorOffsetShadows+colorOffset);

	float3 colorHighlights = ColorCorrect(color, 
		colorContrastHighlights*colorContrast, 
		colorSaturationHighlights*colorSaturation, 
		colorGammaHighlights*colorGamma, 
		colorGainHighlights*colorGain, 
		colorOffsetHighlights+colorOffset);

	float3 colorMidtones = ColorCorrect(color, 
		colorContrastMidtones*colorContrast, 
		colorSaturationMidtones*colorSaturation, 
		colorGammaMidtones*colorGamma, 
		colorGainMidtones*colorGain, 
		colorOffsetMidtones+colorOffset);

	float weightLuma = luminance(color);
	float weightShadows = 1 - smoothstep(0, colorCorrectionShadowsMax, weightLuma);
	float weightHighlights = smoothstep(colorCorrectionHighlightsMin, 1, weightLuma);
	float weightMidtones = 1 - weightShadows - weightHighlights;

	colorShadows *= weightShadows;
	colorMidtones *= weightMidtones;
	colorHighlights *= weightHighlights;

	float3 blend = colorShadows + colorMidtones + colorHighlights;
	return blend;
}

float3 TonemapACES(float3 x)
{
	const float A = 2.51f;
	const float B = 0.03f;
	const float C = 2.43f;
	const float D = 0.59f;
	const float E = 0.14f;
	return (x * (A * x + B)) / (x * (C * x + D) + E);
}

float3 TonemapHejl2015(float3 hdr, float whitePt) 
{
	float4 vh = float4(hdr, whitePt);
	float4 va = 1.425 * vh + 0.05;
	float4 vf = (vh * va + 0.004) / (vh * (va + 0.55) + 0.0491) - 0.0821;
	return vf.rgb / vf.www;
}

float4 TonemapHable(float4 x) 
{
	float A = 0.22;
	float B = 0.30;
	float C = 0.10;
	float D = 0.20;
	float E = 0.01;
	float F = 0.30;
	return ((x*(A*x+C*B)+D*E) / (x*(A*x+B)+D*F)) - E / F;
}

float3 TonemapNaughtyDog(float3 x)
{		
	float A = -2586.3655;
	float B =  0.6900;
	float C = -767.6706;
	float D = -8.5706;
	float E =  2.8784;
	float F =  107.4683;
	return ((x*(A*x+C*B)+D*E) / (x*(A*x+B)+D*F)) - E / F;
}

float3 TonemapReinhardLumaBased(float3 color, float whitePt)
{
	float luma = luminance(color);
	float toneMappedLuma = luma * (1 + luma / (whitePt * whitePt))/ (1 + luma);
	color *= toneMappedLuma / luma;
	return color;
}

// ponytail: ACES Fitted curve (Stephen Hill) provides accurate filmic response without color shifting in bright highlights
float3 TonemapACESFitted(float3 color)
{
	static const float3x3 ACESInputMat = {
		0.59719, 0.35458, 0.04823,
		0.07600, 0.90834, 0.01566,
		0.02840, 0.13383, 0.83777
	};
	static const float3x3 ACESOutputMat = {
		 1.60475, -0.53108, -0.07367,
		-0.10208,  1.10813, -0.00605,
		-0.00327, -0.07276,  1.07602
	};
	color = mul(ACESInputMat, color);
	float3 a = color * (color + 0.0245786) - 0.000090537;
	float3 b = color * (0.983729 * color + 0.4329510) + 0.238081;
	color = a / b;
	return saturate(mul(ACESOutputMat, color));
}

// AgX Tonemapping (Troy Sobotka / Blender 4.0 OCIO standard) - preserves chromatic purity and hue in extreme highlights
float3 TonemapAgX(float3 val)
{
	static const float3x3 AgXInsetMat = {
		0.842479065f, 0.078433600f, 0.079223745f,
		0.042328242f, 0.878468640f, 0.079166127f,
		0.042375655f, 0.078433600f, 0.879142973f
	};
	static const float3x3 AgXOutMat = {
		 1.1968790f, -0.05289685f, -0.05297164f,
		-0.09802088f,  1.15190312f, -0.09804345f,
		-0.09902975f, -0.07547978f,  1.15107314f
	};

	val = max(1e-6f, val);
	val = mul(AgXInsetMat, val);

	// Normalized log2 encoding over [-10.0 EV, +6.5 EV] range (16.5 stops dynamic range)
	val = clamp((log2(val) + 10.0f) / 16.5f, 0.0f, 1.0f);

	// Exact 6th-order polynomial fit of the official Blender 4.0 / OCIO AgX Base Contrast S-Curve
	val = val * (val * (val * (val * (val * (15.5f * val - 40.14f) + 31.96f) - 6.868f) + 0.4298f) + 0.1191f) - 0.00232f;

	val = mul(AgXOutMat, val);
	return saturate(val);
}

float3 ColorToneMapping(float3 color)
{
#if HDR_TONEMAP_OPERATOR == 1
	float3 curr = TonemapReinhardLumaBased(color, 4.0);
	return saturate(curr);
#elif HDR_TONEMAP_OPERATOR == 2
	float4 curr = TonemapHable(float4(color * 2, 4.0));
	curr = curr / curr.w;
	return saturate(curr.rgb);
#elif HDR_TONEMAP_OPERATOR == 3
	float4 curr = TonemapHable(float4(color * 2, 8.0));
	curr = curr / curr.w;
	return saturate(curr.rgb);
#elif HDR_TONEMAP_OPERATOR == 4
	float3 curr = TonemapHejl2015(color, 4.0);
	return saturate(curr);
#elif HDR_TONEMAP_OPERATOR == 5
	float3 curr = TonemapACES(color);
	return saturate(curr);
#elif HDR_TONEMAP_OPERATOR == 6
	float3 curr = TonemapNaughtyDog(color);
	return saturate(curr);
#elif HDR_TONEMAP_OPERATOR == 7
	float3 curr = TonemapACESFitted(color);
	return saturate(curr);
#elif HDR_TONEMAP_OPERATOR == 8
	float3 curr = TonemapAgX(color);
	return saturate(curr);
#else
	return saturate(color);
#endif
}