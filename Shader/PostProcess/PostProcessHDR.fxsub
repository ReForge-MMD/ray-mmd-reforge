#ifndef FILMIC_HALATION_MODE
#	define FILMIC_HALATION_MODE 1
#endif

#if POST_DISPERSION_MODE == 2
float3 SampleSpectrum(float x)
{
	float t = 3.0 * x - 1.5;
	return saturate(float3(-t, 1 - abs(t), t));
}

float3 ChromaticAberration(sampler source, float2 coord, float2 offset)
{
	const int samples = 8;

	float3 totalColor = 0.0;
	float3 totalWeight = 0.0;
	float2 delta = offset / samples;

	[unroll]
	for (int i = 0; i <= samples; i++, coord += delta)
	{
		float3 w = SampleSpectrum(float(i) / samples);

		totalWeight += w;
		totalColor += w * tex2Dlod(source, float4(coord, 0, 0)).rgb;
	}

	return totalColor / totalWeight;
}
#endif

float3 ColorDispersion(sampler source, float2 coord, float inner, float outer)
{
	const float scale = ((ViewportSize.x * 0.5) / 512);
#if POST_DISPERSION_MODE == 1
	float L = length(coord * 2 - 1);
	L = 1 - smoothstep(outer, inner, L);
	float2 offset = ViewportOffset2 * L * (mDispersion * 8) * scale;
	float3 shift1 = tex2Dlod(source, float4(coord - offset, 0, 0)).rgb;
	float3 shift2 = tex2Dlod(source, float4(coord, 0, 0)).rgb;
	float3 shift3 = tex2Dlod(source, float4(coord + offset, 0, 0)).rgb;
	return float3(shift1.r, shift2.g, shift3.b);
#elif POST_DISPERSION_MODE == 2
	float L = 1 - smoothstep(outer, inner, length(coord * 2 - 1));
	float2 dist = ViewportOffset2 * L * (mDispersion * 16) * scale;
	float2 offset = (coord * 2 - 1.0) * dist;
	return ChromaticAberration(source, coord, offset);
#elif POST_DISPERSION_MODE == 3
	// Cinematic Barrel Lens Dispersion: Quadratic radial offset (r^2) with spectral separation
	float2 ndc = coord * 2.0f - 1.0f;
	float r2 = dot(ndc, ndc);
	float lensDistort = r2 * (mDispersion * 0.02f + 0.005f);
	float2 offsetR = ndc * (lensDistort * 1.25f) * ViewportOffset2 * 100.0f;
	float2 offsetB = ndc * (lensDistort * 0.65f) * ViewportOffset2 * 100.0f;
	float r = tex2Dlod(source, float4(coord + offsetR, 0, 0)).r;
	float g = tex2Dlod(source, float4(coord, 0, 0)).g;
	float b = tex2Dlod(source, float4(coord - offsetB, 0, 0)).b;
	return float3(r, g, b);
#else
	if (mDispersion > 1e-4)
	{
		float2 distFromCenter = coord - 0.5;
		float rDist = length(distFromCenter);
		float2 offset = distFromCenter * rDist * (mDispersion * 0.015);
		float r = tex2Dlod(source, float4(coord + offset, 0, 0)).r;
		float g = tex2Dlod(source, float4(coord, 0, 0)).g;
		float b = tex2Dlod(source, float4(coord - offset, 0, 0)).b;
		return float3(r, g, b);
	}
	return tex2Dlod(source, float4(coord, 0, 0)).rgb;
#endif
}

float4 HDRTonemappingVS(
	in float4 Position : POSITION,
	in float4 Texcoord : TEXCOORD,
	out float4 oTexcoord : TEXCOORD0) : POSITION
{
	oTexcoord = Texcoord;
	oTexcoord.xy += ViewportOffset;
	oTexcoord.zw = mExposure;
#if HDR_EYE_ADAPTATION == 1
	float aveLum = tex2Dlod(EyeLumAveMapSamp, float4(0.5,0.5,0,0)).r;
	oTexcoord.zw *= ComputeExposureISO(aveLum, 12.5);
#elif HDR_EYE_ADAPTATION == 2
	float aveLum = tex2Dlod(EyeLumAveMapSamp, float4(0.5,0.5,0,0)).r;
	oTexcoord.zw *= ComputeExposureISO(aveLum, 18.0);
#endif
	return Position;
}

float3 ComputeFilmicHalation(float3 baseColor, float2 uv)
{
#if FILMIC_HALATION_MODE > 0
#if HDR_BLOOM_MODE > 0
	float3 bloomTight = tex2Dlod(BloomSamp2nd, float4(uv, 0, 0)).rgb;
	float3 bloomWide  = tex2Dlod(BloomSamp3rd, float4(uv, 0, 0)).rgb;
	float3 tightBloom = bloomTight * 0.65f + bloomWide * 0.35f;
#else
	float3 tightBloom = baseColor;
#endif

	// Luminance of scattered highlight vs baseline color
	float bloomLum = dot(tightBloom, float3(0.299f, 0.587f, 0.114f));
	float baseLum  = dot(baseColor, float3(0.299f, 0.587f, 0.114f));

	// Film emulsion overexposure response: starts where highlight begins to clip
	float overexposure = smoothstep(0.20f, 1.10f, bloomLum);
	// Contrast edge bleed: stronger when bright light spills onto darker surroundings
	float edgeBleed = saturate((bloomLum * 1.35f - baseLum) / max(bloomLum, 0.1f));
	float halationFactor = overexposure * (edgeBleed * 0.70f + 0.30f);

	// CineStill 800T / Kodak Vision3 iconic warm crimson-amber halation color
	const float3 kHalationColor = float3(1.0f, 0.18f, 0.035f);

#if FILMIC_HALATION_MODE == 1
	float intensity = 0.65f;
#elif FILMIC_HALATION_MODE == 2
	float intensity = 1.35f;
#elif FILMIC_HALATION_MODE == 3
	float intensity = 2.20f;
#else
	float intensity = 0.65f;
#endif

	return kHalationColor * (halationFactor * intensity * saturate(bloomLum));
#else
	return 0.0f;
#endif
}

float4 HDRTonemappingPS(in float4 coord: TEXCOORD0, uniform sampler source) : COLOR
{
	float3 color = ColorDispersion(source, coord.xy, mDispersionRadius, 1.0 + mDispersionRadius);

	color *= coord.z;

#if HDR_BLOOM_MODE > 0
	float3 bloom = tex2Dlod(BloomSamp1st, float4(coord.xy, 0, 0)).rgb;
	color += bloom;
#endif

#if FILMIC_HALATION_MODE > 0
	color += ComputeFilmicHalation(color, coord.xy);
#endif

	color = ColorTemperature(color, mColorTemperature);
	if (abs(mColorTint) > 1e-4f)
		color = ColorTint(color, mColorTint);
	if (abs(mColorVibrance) > 1e-4f)
		color = ColorVibrance(color, mColorVibrance);
	if (abs(mColorHue) > 1e-4f)
		color = ColorHueShift(color, mColorHue);

	if (mEnable3WayGrading)
	{
		color = ColorGrade3Way(
			color,
			mShadowSaturation, mShadowContrast, mShadowGain, mShadowLift,
			mMidtoneSaturation, mMidtoneContrast, mMidtoneGain,
			mHighlightSaturation, mHighlightContrast, mHighlightGain,
			mColorGradingShadowMax, mColorGradingHighlightMin);
	}

	color = ColorCorrect(color, mColorSaturation, mColorContrast, mColorGamma, mColorBalanceP, mColorBalanceM);

	if (mTealOrange > 1e-4f)
		color = ApplyTealOrange(color, mTealOrange);
	if (mBleachBypass > 1e-4f)
		color = ApplyBleachBypass(color, mBleachBypass);
	if (mCrossProcess > 1e-4f)
		color = ApplyCrossProcess(color, mCrossProcess);
	if (mMonochrome > 1e-4f)
		color = ApplyMonochrome(color, mMonochrome);

	color = ColorVignette(color, coord.xy);
	color = ColorToneMapping(color);

	color = linear2srgb(color);
	color = ColorDithering(color, coord.xy);

#if AA_QUALITY > 0
	return float4(color, luminance(color));
#else
	return float4(color, 1);
#endif
}